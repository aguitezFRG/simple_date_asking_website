# Server-only pooled Postgres connection string from the dedicated Supabase project.
SUPABASE_CONNECTION_STRING=

# Supabase Auth project settings. These are read only by server routes in this app.
# The publishable key is safe to expose by design, but no NEXT_PUBLIC_ variable is needed.
SUPABASE_PROJECT_URL=
SUPABASE_PUBLIC_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
DATE_RESPONSE_FROM_EMAIL=
